{
  "name": "Seasonal Retail Executive Theme",
  "dataColors": [
    "#10B981",
    "#F59E0B",
    "#EA580C",
    "#3B82F6",
    "#8B5CF6",
    "#EC4899",
    "#06B6D4",
    "#64748B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#3B82F6",
  "visualStyles": {
    "*": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#0F172A" } } }],
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 12 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#CBD5E1" } }, "transparency": 80, "preset": "BottomRight" }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold, Inter, sans-serif"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#0F172A" } }, "fontSize": 24, "fontFamily": "Segoe UI Bold" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#64748B" } }, "fontSize": 10 }]
      }
    }
  }
}
