// ============================================================================
// DAX Measures Library for Retail Seasonal Sales Trend Dashboard
// Table: '_Measures' (Dedicated disconnected table for measure governance)
// Strictly adheres to Microsoft Power BI Enterprise Modeling Best Practices
// ============================================================================

// ----------------------------------------------------------------------------
// 1. CORE VOLUME & REVENUE MEASURES
// ----------------------------------------------------------------------------

[Total Sales] = 
SUM(FactSales[Revenue])
/* FormatString: "$#,##0.00;($#,##0.00);$0.00" */
/* Display Folder: "1. Core Financials" */

[Total Profit] = 
SUM(FactSales[Profit])
/* FormatString: "$#,##0.00;($#,##0.00);$0.00" */
/* Display Folder: "1. Core Financials" */

[Profit Margin %] = 
DIVIDE(
    [Total Profit], 
    [Total Sales], 
    0
)
/* FormatString: "0.0%" */
/* Display Folder: "1. Core Financials" */

[Units Sold] = 
SUM(FactSales[Quantity])
/* FormatString: "#,##0" */
/* Display Folder: "1. Core Financials" */

[Total Orders] = 
DISTINCTCOUNT(FactSales[OrderID])
/* FormatString: "#,##0" */
/* Display Folder: "1. Core Financials" */

[Average Order Value] = 
DIVIDE(
    [Total Sales], 
    DISTINCTCOUNT(FactSales[OrderID]), 
    0
)
/* FormatString: "$#,##0.00;($#,##0.00);$0.00" */
/* Display Folder: "1. Core Financials" */

[Avg Discount %] = 
AVERAGE(FactSales[Discount])
/* FormatString: "0.0%" */
/* Display Folder: "1. Core Financials" */


// ----------------------------------------------------------------------------
// 2. TIME INTELLIGENCE & YEAR-OVER-YEAR (YoY)
// ----------------------------------------------------------------------------

[Sales Last Year (LY)] = 
CALCULATE(
    [Total Sales], 
    SAMEPERIODLASTYEAR(DimDate[Date])
)
/* FormatString: "$#,##0.00;($#,##0.00);$0.00" */
/* Display Folder: "2. Time Intelligence" */

[Profit Last Year (LY)] = 
CALCULATE(
    [Total Profit], 
    SAMEPERIODLASTYEAR(DimDate[Date])
)
/* FormatString: "$#,##0.00;($#,##0.00);$0.00" */
/* Display Folder: "2. Time Intelligence" */

[YoY Growth %] = 
VAR SalesCurrent = [Total Sales]
VAR SalesPrior = [Sales Last Year (LY)]
RETURN
    DIVIDE(
        SalesCurrent - SalesPrior, 
        SalesPrior, 
        BLANK()
    )
/* FormatString: "+0.0%;-0.0%;0.0%" */
/* Display Folder: "2. Time Intelligence" */

[YoY Profit Growth %] = 
VAR ProfitCurrent = [Total Profit]
VAR ProfitPrior = [Profit Last Year (LY)]
RETURN
    DIVIDE(
        ProfitCurrent - ProfitPrior, 
        ProfitPrior, 
        BLANK()
    )
/* FormatString: "+0.0%;-0.0%;0.0%" */
/* Display Folder: "2. Time Intelligence" */


// ----------------------------------------------------------------------------
// 3. SEASONAL INTELLIGENCE & BENCHMARKING
// ----------------------------------------------------------------------------

// Seasonal Index: Compares the sales in the current month against the baseline monthly average
[Seasonal Index] = 
VAR CurrentSales = [Total Sales]
VAR AvgMonthlySales = 
    AVERAGEX(
        ALL(DimDate[Month]), 
        [Total Sales]
    )
RETURN
    DIVIDE(CurrentSales, AvgMonthlySales, BLANK())
/* FormatString: "0.00" */
/* Display Folder: "3. Seasonal Benchmarks" */

// Season Share %: Evaluates the proportion of sales generated by each season across the entire year
[Season Share %] = 
DIVIDE(
    [Total Sales], 
    CALCULATE([Total Sales], ALL(DimSeason)), 
    0
)
/* FormatString: "0.0%" */
/* Display Folder: "3. Seasonal Benchmarks" */

// 3-Month Moving Average: Smooths short-term fluctuations to reveal underlying seasonal trajectory
[3-Month Moving Average] = 
AVERAGEX(
    DATESINPERIOD(
        DimDate[Date], 
        LASTDATE(DimDate[Date]), 
        -3, 
        MONTH
    ), 
    [Total Sales]
)
/* FormatString: "$#,##0.00;($#,##0.00);$0.00" */
/* Display Folder: "3. Seasonal Benchmarks" */


// ----------------------------------------------------------------------------
// 4. ADVANCED VISUAL FORMATTING & CONDITIONAL FORMATTING HELPERS
// ----------------------------------------------------------------------------

[Seasonal Theme Color] = 
SWITCH(
    SELECTEDVALUE(DimSeason[SeasonName], SELECTEDVALUE(DimDate[Season])),
    "Spring", "#10B981",  // Vibrant Emerald
    "Summer", "#F59E0B",  // Golden Amber
    "Fall",   "#EA580C",  // Terracotta Warm Pumpkin
    "Winter", "#3B82F6",  // Royal Ice Blue
    "#64748B"             // Neutral Slate
)
/* Display Folder: "4. UI Formatting" */

[YoY Growth KPI Color] = 
IF(
    [YoY Growth %] >= 0, 
    "#10B981", // Green positive
    "#EF4444"  // Red negative
)
/* Display Folder: "4. UI Formatting" */

[Dynamic Page Title] = 
"Seasonal Sales Performance | " & 
IF(ISFILTERED(DimDate[Year]), "Year: " & SELECTEDVALUE(DimDate[Year]), "All Years (2023-2025)") & 
IF(ISFILTERED(DimSeason[SeasonName]), " | Season: " & SELECTEDVALUE(DimSeason[SeasonName]), " | All Seasons")
/* Display Folder: "4. UI Formatting" */
